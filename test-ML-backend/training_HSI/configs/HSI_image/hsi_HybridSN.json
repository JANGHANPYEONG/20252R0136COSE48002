{
  "experiment": "hsi_hybridSN",
  "model": {
    "file": "hsi_HybridSN",
    "name": "HSIHybridSN",
    "num_classes": 13,
    "in_chs": 5,
    "patch_size": 25,
    "dropout": 0.3,
    "activation": "relu",
    "init_type": "kaiming_normal",
    "pretrained": false,
    "conv1_kernel": [
      3,
      3,
      3
    ],
    "conv2_kernel": [
      2,
      3,
      3
    ],
    "conv3_kernel": [
      2,
      3,
      3
    ],
    "conv4_kernel": [
      3,
      3
    ],
    "conv_channels": [
      16,
      32,
      64,
      128
    ],
    "fc_units": [
      512,
      256
    ],
    "fc_dropout": 0.3
  },
  "data": {
    "csv": "/mnt/data/datasets_HSI/label/label.csv",
    "column_config": "configs/column_config.json",
    "val_split": 0.15,
    "test_split": 0.15,
    "batch_size": 16,
    "num_workers": 7,
    "crop_size": [
      25,
      25
    ],
    "use_flip": true,
    "use_rotation": true,
    "use_noise": true,
    "use_brightness_contrast": true,
    "scaler_mode": "normalized"
  },
  "train": {
    "epochs": 100,
    "early_stopping_patience": 20,
    "optimizer": "Adam",
    "lr": 0.0005,
    "scheduler": "ReduceLROnPlateau",
    "scheduler_patience": 10,
    "scheduler_factor": 0.3,
    "loss_fn": "uncertainty",
    "use_amp": false,
    "grad_clip_norm": 1.0,
    "save_interval": 5
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5000",
    "experiment_name": "HSI_HybridSN"
  },
  "plot_keys": [
    "cls_f1_score",
    "reg_r2",
    "combined_score"
  ],
  "seed": 42
}