{
  "experiment": "hsi_realtime2dcnn_experiment",
  "model": {
    "file": "hsi_realtime2dcnn",
    "num_classes": 13,
    "num_regression_targets": 0,
    "hsi_channels": 5
  },
  "data": {
    "csv": "datasets_HSI/label/label.csv",
    "column_config": "datasets_HSI/column_config.json",
    "val_split": 0.1,
    "test_split": 0.1,
    "batch_size": 8,
    "num_workers": 4,
    "crop_size": [224, 224],
    "use_flip": true,
    "use_rotation": true,
    "use_noise": true,
    "use_brightness_contrast": true,
    "scalar_mode": "normalized"
  },
  "train": {
    "epochs": 10,
    "early_stopping_patience": 10,
    "optimizer": "AdamW",
    "lr": 0.0003,
    "scheduler": "ReduceLROnPlateau",
    "loss_fn": "uncertainty"
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5000",
    "experiment_name": "HSI_2D_CNN"
  },
  "plot_keys": ["cls_f1_score", "reg_r2", "combined_score"],
  "seed": 42
}
