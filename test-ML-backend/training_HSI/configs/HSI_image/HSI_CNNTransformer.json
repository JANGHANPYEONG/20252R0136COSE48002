{
  "experiment": "hsi_cnn_transformer_mt",
  "model": {
    "file": "HSI_CNNTransformer",
    "in_bands": 5,
    "cnn_channels": [32, 64, 128],
    "num_bands": 5,
    "token_dim": 64,
    "trans_layers": 6,
    "trans_heads": 4,
    "trans_ffn_dim": 1024,
    "num_classes": 13,
    "num_regression_targets": 0,
    "use_pool": true
  },
  "data": {
    "csv": "../datasets_HSI/label/label.csv",
    "column_config": "../datasets_HSI/column_config.json",
    "val_split": 0.1,
    "test_split": 0.1,
    "batch_size": 8,
    "num_workers": 4,
    "crop_size": [224, 224],
    "use_flip": true,
    "use_rotation": true,
    "use_noise": true,
    "use_brightness_contrast": true,
    "scaler_mode": "normalized"
  },
  "train": {
    "epochs": 50,
    "early_stopping_patience": 10,
    "optimizer": "AdamW",
    "lr": 3e-4,
    "scheduler": "ReduceLROnPlateau",
    "scheduler_patience": 5,
    "scheduler_factor": 0.5,
    "loss_fn": "uncertainty",
    "use_amp": false,
    "grad_clip_norm": null
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5000",
    "experiment_name": "HSI_CNN_Transformer_MT"
  },
  "plot_keys": ["cls_f1_score", "reg_r2", "combined_score"],
  "seed": 42
}
