{
  "experiment": "dual_branch_regression",
  "model": {
    "file": "dual_branch_regression",
    "num_classes": 13,
    "num_regression_targets": 2,
    "hsi_channels": 5,
    "vector_size": 5
  },
  "data": {
    "csv": "datasets_HSI/label/label.csv",
    "column_config": "../column_config.json",
    "val_split": 0.1,
    "test_split": 0.1,
    "batch_size": 8,
    "num_workers": 4,
    "crop_size": [32, 32],
    "use_flip": true,
    "use_rotation": true,
    "use_noise": true,
    "use_brightness_contrast": true
  },
  "train": {
    "epochs": 50,
    "early_stopping_patience": 10,
    "optimizer": "AdamW",
    "lr": 3e-4,
    "scheduler": "ReduceLROnPlateau"
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5000",
    "experiment_name": "HSI_2D_CNN_REGRESSION"
  },
  "seed": 42
}
