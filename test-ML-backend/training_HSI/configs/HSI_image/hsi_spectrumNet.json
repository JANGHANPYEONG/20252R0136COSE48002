{
  "experiment": "hsi_spectrumNet",
  "model": {
    "file": "hsi_spectrumNet",
    "num_classes": 13,
    "in_channels": 5,
    "dropout": 0.2
  },
  "data": {
    "csv": "/mnt/data/datasets_HSI/label/label.csv",
    "column_config": "configs/column_config_nubci.json",
    "val_split": 0.1,
    "test_split": 0.1,
    "batch_size": 32,
    "num_workers": 4,
    "crop_size": [224, 224],
    "use_flip": true,
    "use_rotation": true,
    "use_noise": true,
    "use_brightness_contrast": true,
    "scaler_mode": "normalized"
  },
  "train": {
    "epochs": 2,
    "early_stopping_patience": 30,
    "optimizer": "AdamW",
    "lr": 2e-4,
    "scheduler": "CosineAnnealingLR",
    "loss_fn": "dynamic",
    "use_amp": true,
    "grad_clip_norm": 1
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5000",
    "experiment_name": "HSI_SpectrumNet"
  },
  "plot_keys": [
    "cls_f1_score",
    "reg_r2",
    "cls_recall",
    "cls_precision",
    "cls_auc"
  ],
  "seed": 42
}
