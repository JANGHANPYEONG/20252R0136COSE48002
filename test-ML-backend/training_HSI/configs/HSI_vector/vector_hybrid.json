{
  "experiment": "hybrid",
  "model": {
    "file": "hybrid",
    "num_classes": 13
  },
  "data": {
    "csv": "../datasets_HSI/label/label.csv",
    "column_config": "./configs/column_config.json",
    "K-fold": 5,
    "test_split": 0.1
  },
  "train": {
    "method" : "no",
    "scoring": "mt_scorer",
    "n_estimators": 10,
    "max_depth": 5,
    "min_samples_split": 2,
    "min_samples_leaf": 1,
    "param_grid" : {
      "estimator__max_depth": [2, 20]
    }
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5000",
    "experiment_name": "Vector_ML"
  },
  "scaler": "standardscaler",
  "plot_keys": ["cls_f1_score", "reg_r2", "combined_score"],
  "seed": 42,
  "TS_path": "/mnt/data/datasets_HSI/image/TS_image",
  "VS_path": "/mnt/data/datasets_HSI/image/VS_image",
  "TS_label": "/mnt/data/datasets_HSI/label/TS_tmp.csv",
  "vS_label": "/mnt/data/datasets_HSI/label/VS_label.csv"
}
