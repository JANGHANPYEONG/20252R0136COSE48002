{
  "experiment": "vector_randomforest_baseline",
  "model": {
    "file": "vector_randomforest",
    "num_classes": 13
  },
  "data": {
    "csv": "../datasets_HSI/label/label.csv",
    "column_config": "../configs/column_config.json",
    "test_split": 0.2
  },
  "train": {
    "method": "bayessearchcv",
    "cv": 5,
    "scoring": "mt_scorer",
    "n_iter": 30,
    "n_jobs": -1,
    "verbose": false,
    "param_fixed": {},
    "param_grid": {
      "n_estimators": [10, 100],
      "max_depth": [2, 20],
      "min_samples_split": [2, 10],
      "min_samples_leaf": [2, 10]
    }
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5000",
    "experiment_name": "Vector_ML"
  },
  "plot_param": [],
  "seed": 42
}
