{
  "experiment": "vector_plsr_baseline",
  "model": {
    "file": "vector_plsr",
    "num_classes": 13
  },
  "data": {
    "csv": "../datasets_HSI/label/label.csv",
    "column_config": "../datasets_HSI/column_config.json",
    "test_split": 0.2
  },
  "train": {
    "method": "gridsearchcv",
    "cv": 5,
    "scoring": "mt_scorer",
    "n_jobs": -1,
    "verbose": false,
    "param_fixed": {
      "tol": 1e-06,
      "copy": true,
      "max_iter": 500
    },
    "param_grid": {
      "plsr__n_components": [2, 5, 8, 12],
      "plsr__scale": [true, false]
    }
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5000",
    "experiment_name": "Vector_ML"
  },
  "scaler": "msc",
  "seed": 42
}
