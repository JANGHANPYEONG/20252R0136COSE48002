{
  "experiment": "vector_svm_baseline",
  "model": {
    "file": "vector_svm",
    "num_classes": 13
  },
  "data": {
    "csv": "../datasets_HSI/label/label.csv",
    "column_config": "../column_config.json",
    "K-fold": 5,
    "test_split": 0.1
  },
  "train": {
    "kernel": "rbf",
    "C": 1.0,
    "gamma": "scale",
    "degree": 3,
    "coef0": 0.0
  },
  "mlflow": {
    "tracking_uri": "http://127.0.0.1:5000",
    "experiment_name": "Vector_ML"
  },
  "scaler": "",
  "seed": 42
}
